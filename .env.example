# Server configuration
PORT=3000
NODE_ENV=development

# Public site URL (canonical URLs and social previews use https://skylarkstarlogistics.com)
APP_URL="https://skylarkstarlogistics.com"

# Webhook that receives validated quote requests as JSON (POST).
# Until this is set, the quote form validates submissions but does NOT deliver them anywhere.
# Works with Zapier / Make / n8n webhooks, a CRM inbound webhook, or your own email relay.
QUOTE_WEBHOOK_URL=""

# Set to 1 when the app runs behind a reverse proxy or load balancer
# (Render, Railway, Fly.io, Cloud Run, Nginx...) so rate limiting sees real visitor IPs.
TRUST_PROXY=""
